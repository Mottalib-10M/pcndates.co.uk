---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/which-parking-ticket/" title="Which parking ticket have I got?" width="100%" height="720" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/parking-fine-countdown/" title="Parking ticket deadline countdown" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code3 = `<iframe src="${SITE_URL}/embed/parking-appeal-letter/" title="Parking appeal letter builder" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free parking ticket checker on your website" description="Put the parking ticket checker, the deadline countdown or the appeal letter builder on your website: one iframe, no sign-up, no tracking, no cookie and no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a parking ticket tool</h1>
    <p class="mt-3 text-lg text-navy-700">For advice services, libraries, community groups and councils that help drivers read a ticket.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Which parking ticket have I got?</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Deadline countdown</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <h2>Appeal letter builder</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code3}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. When an amount or a rule changes, the embedded tool updates itself. Nothing your visitors type reaches us and the frame sets no cookie. Each frame states that the site is independent and not a council, operator or appeals service. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/which-parking-ticket/" title="Which parking ticket have I got?" width="100%" height="720" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
